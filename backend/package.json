{
  "name": "realestate-crm-backend",
  "version": "1.0.0",
  "description": "Real Estate CRM backend API - Node.js + Express + PostgreSQL + Prisma",
  "main": "src/server.js",
  "type": "commonjs",
  "license": "ISC",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:up": "node scripts/pg-local.js up",
    "db:down": "node scripts/pg-local.js down"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "16.4.0-beta.14",
    "nodemon": "^3.1.7",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@16.4.0-beta.14": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
