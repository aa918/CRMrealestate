# ==================================================
# SERVER
# ==================================================
PORT=3000
NODE_ENV=development

# ==================================================
# DATABASE (PostgreSQL via Prisma)
# ==================================================
# Example local:      postgresql://postgres:postgres@localhost:5432/realestate_crm?schema=public
# Example Supabase:   postgresql://postgres:[password]@[host]:5432/postgres
# Example Neon:       postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate_crm?schema=public

# ==================================================
# AUTH
# ==================================================
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# ==================================================
# SPEED TO LEAD
# ==================================================
# Minutes an agent has to respond before a lead is marked OVERDUE
LEAD_RESPONSE_SLA_MINUTES=15

# ==================================================
# N8N AUTOMATION INTEGRATION
# ==================================================
# URL of the n8n webhook that should receive lead.created (and other) events
N8N_LEAD_WEBHOOK_URL=
# Shared secret sent as X-N8N-Secret header so n8n can verify the request came from us
N8N_API_SECRET=change-this-n8n-shared-secret

# ==================================================
# INTERNAL API (server-to-server / n8n scheduled jobs)
# ==================================================
# Required header X-Internal-Api-Key on /api/internal/* endpoints
INTERNAL_API_KEY=change-this-internal-api-key

# ==================================================
# PUBLIC LEAD FORM
# ==================================================
# Fallback/master key usable in development against the seeded demo organization.
# In production every Organization has its own generated publicApiKey (see Organization.publicApiKey)
# which is the recommended way to identify which org a public lead belongs to.
PUBLIC_LEAD_API_KEY=change-this-public-lead-key

# ==================================================
# FACEBOOK LEAD ADS (optional - mock mode used until configured)
# ==================================================
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v20.0

# ==================================================
# WHATSAPP CLOUD API (optional - mock provider used until configured)
# ==================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# ==================================================
# CORS
# ==================================================
# Comma separated list of allowed origins. Leave empty to allow all in development.
CORS_ORIGINS=
